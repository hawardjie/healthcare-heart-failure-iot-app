# Local Development Configuration
ENVIRONMENT=local

# Multi-Tenancy
TENANT_A_ID=clinic-alpha
TENANT_B_ID=hospital-beta

# MQTT Broker (EMQX local)
MQTT_BROKER_HOST=emqx
MQTT_BROKER_PORT=1883
MQTT_USERNAME=admin
MQTT_PASSWORD=public

# TimescaleDB
POSTGRES_USER=iot_admin
POSTGRES_PASSWORD=local_dev_password
POSTGRES_DB=heart_failure_iot
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432
DATABASE_URL=postgresql://iot_admin:local_dev_password@timescaledb:5432/heart_failure_iot

# LocalStack
LOCALSTACK_HOST=localstack
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localstack:4566

# ML Service
ML_SERVICE_HOST=ml_service
ML_SERVICE_PORT=8000
ML_MODEL_PATH=/app/models/anomaly_model.onnx

# Dashboard
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_WS_URL=ws://localhost:3000

# Simulator
SIMULATOR_DEVICE_COUNT=500
SIMULATOR_MESSAGE_INTERVAL=60
SIMULATOR_TENANTS=clinic-alpha,hospital-beta

# Feature Flags
ENABLE_ML_SCORING=true
ENABLE_FHIR_SYNC=false
ENABLE_PHI_AUDIT=true
